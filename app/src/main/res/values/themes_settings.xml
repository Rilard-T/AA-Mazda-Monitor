<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Тема экранов настроек (0.8.0). Приборная панель использует AppTheme и AppTheme.*, их не трогаем. -->
    <style name="Theme.App.Settings" parent="Theme.Material3.DayNight">
        <item name="android:listDivider">@drawable/ms_no_divider</item>
        <item name="colorPrimary">@color/ms_primary</item>
        <item name="colorOnPrimary">@color/ms_on_primary</item>
        <item name="colorPrimaryContainer">@color/ms_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/ms_on_primary_container</item>
        <item name="colorSecondary">@color/ms_secondary</item>
        <item name="colorOnSecondary">@color/ms_on_secondary</item>
        <item name="colorSecondaryContainer">@color/ms_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/ms_on_secondary_container</item>
        <item name="colorTertiary">@color/ms_tertiary</item>
        <item name="colorOnTertiary">@color/ms_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/ms_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/ms_on_tertiary_container</item>
        <!-- инверсный акцент: текст действия в Snackbar (по умолчанию в Material 3 он не из палитры) -->
        <item name="colorPrimaryInverse">@color/accent_blue_inverse</item>
        <item name="colorError">@color/ms_error</item>
        <item name="colorOnError">@color/ms_on_error</item>
        <item name="colorErrorContainer">@color/ms_error_container</item>
        <item name="colorOnErrorContainer">@color/ms_on_error_container</item>
        <item name="android:colorBackground">@color/ms_background</item>
        <item name="colorOnBackground">@color/ms_on_background</item>
        <item name="colorSurface">@color/ms_surface</item>
        <item name="colorOnSurface">@color/ms_on_surface</item>
        <item name="colorSurfaceVariant">@color/ms_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/ms_on_surface_variant</item>
        <item name="colorOutline">@color/ms_outline</item>
        <item name="colorOutlineVariant">@color/ms_outline_variant</item>
        <item name="colorSurfaceContainerLowest">@color/ms_sc_lowest</item>
        <item name="colorSurfaceContainerLow">@color/ms_sc_low</item>
        <item name="colorSurfaceContainer">@color/ms_sc</item>
        <item name="colorSurfaceContainerHigh">@color/ms_sc_high</item>
        <item name="colorSurfaceContainerHighest">@color/ms_sc_highest</item>
        <!-- Контролы AppCompat (переключатели, флажки, радиокнопки, SeekBar) красятся не из
             colorPrimary, а из этих атрибутов. Повторяем их за акцентом, иначе при динамической
             палитре Material 3 они остались бы базового цвета. -->
        <item name="colorAccent">?attr/colorPrimary</item>
        <item name="android:colorAccent">?attr/colorPrimary</item>
        <item name="colorControlActivated">?attr/colorPrimary</item>
        <!-- верхняя панель и строка состояния одного цвета; значки строки состояния по режиму -->
        <item name="actionBarStyle">@style/Widget.App.ActionBar</item>
        <item name="android:statusBarColor">?attr/colorSurfaceContainer</item>
        <item name="android:windowLightStatusBar">@bool/ms_light_bars</item>
    </style>

    <style name="Widget.App.ActionBar" parent="Widget.Material3.ActionBar.Solid">
        <item name="background">?attr/colorSurfaceContainer</item>
    </style>

    <!-- Нейтральные поверхности поверх динамической палитры Material 3. Акцентный цвет задаёт
         только акцентные роли, а фон, карточки и обводки остаются в палитре приложения. -->
    <style name="ThemeOverlay.App.Surfaces" parent="">
        <item name="android:colorBackground">@color/ms_background</item>
        <item name="colorOnBackground">@color/ms_on_background</item>
        <item name="colorSurface">@color/ms_surface</item>
        <item name="colorOnSurface">@color/ms_on_surface</item>
        <item name="colorSurfaceVariant">@color/ms_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/ms_on_surface_variant</item>
        <item name="colorOutline">@color/ms_outline</item>
        <item name="colorOutlineVariant">@color/ms_outline_variant</item>
        <item name="colorSurfaceContainerLowest">@color/ms_sc_lowest</item>
        <item name="colorSurfaceContainerLow">@color/ms_sc_low</item>
        <item name="colorSurfaceContainer">@color/ms_sc</item>
        <item name="colorSurfaceContainerHigh">@color/ms_sc_high</item>
        <item name="colorSurfaceContainerHighest">@color/ms_sc_highest</item>
    </style>

    <!-- Акцентные overlay-темы Material 3. Раньше переопределялся только colorSecondary, поэтому
         новый цвет получали лишь подписи и контролы оформления; переключатели, радиокнопки,
         кнопки диалогов, ползунки и подсветка нажатий оставались базовыми (синими). Теперь задана
         вся пара семейств primary/secondary, а светлые и тёмные тона берутся из colors_accent.xml. -->
    <style name="ThemeOverlay.App.Accent.Blue" parent="">
        <item name="colorPrimary">@color/ms_primary</item>
        <item name="colorOnPrimary">@color/ms_on_primary</item>
        <item name="colorPrimaryContainer">@color/ms_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/ms_on_primary_container</item>
        <item name="colorSecondary">@color/ms_secondary</item>
        <item name="colorOnSecondary">@color/ms_on_secondary</item>
        <item name="colorSecondaryContainer">@color/ms_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/ms_on_secondary_container</item>
        <item name="colorAccent">@color/ms_primary</item>
        <item name="android:colorAccent">@color/ms_primary</item>
        <item name="colorControlActivated">@color/ms_primary</item>
        <item name="colorControlHighlight">@color/accent_blue_ripple</item>
        <item name="android:colorControlHighlight">@color/accent_blue_ripple</item>
        <item name="colorPrimaryInverse">@color/accent_blue_inverse</item>
    </style>

    <style name="ThemeOverlay.App.Accent.Green" parent="">
        <item name="colorPrimary">@color/accent_green_primary</item>
        <item name="colorOnPrimary">@color/accent_green_on_primary</item>
        <item name="colorPrimaryContainer">@color/accent_green_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/accent_green_on_primary_container</item>
        <item name="colorSecondary">@color/accent_green_secondary</item>
        <item name="colorOnSecondary">@color/accent_green_on_secondary</item>
        <item name="colorSecondaryContainer">@color/accent_green_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/accent_green_on_secondary_container</item>
        <item name="colorAccent">@color/accent_green_primary</item>
        <item name="android:colorAccent">@color/accent_green_primary</item>
        <item name="colorControlActivated">@color/accent_green_primary</item>
        <item name="colorControlHighlight">@color/accent_green_ripple</item>
        <item name="android:colorControlHighlight">@color/accent_green_ripple</item>
        <item name="colorPrimaryInverse">@color/accent_green_inverse</item>
    </style>

    <style name="ThemeOverlay.App.Accent.Red" parent="">
        <item name="colorPrimary">@color/accent_red_primary</item>
        <item name="colorOnPrimary">@color/accent_red_on_primary</item>
        <item name="colorPrimaryContainer">@color/accent_red_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/accent_red_on_primary_container</item>
        <item name="colorSecondary">@color/accent_red_secondary</item>
        <item name="colorOnSecondary">@color/accent_red_on_secondary</item>
        <item name="colorSecondaryContainer">@color/accent_red_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/accent_red_on_secondary_container</item>
        <item name="colorAccent">@color/accent_red_primary</item>
        <item name="android:colorAccent">@color/accent_red_primary</item>
        <item name="colorControlActivated">@color/accent_red_primary</item>
        <item name="colorControlHighlight">@color/accent_red_ripple</item>
        <item name="android:colorControlHighlight">@color/accent_red_ripple</item>
        <item name="colorPrimaryInverse">@color/accent_red_inverse</item>
    </style>

    <style name="ThemeOverlay.App.Accent.Orange" parent="">
        <item name="colorPrimary">@color/accent_orange_primary</item>
        <item name="colorOnPrimary">@color/accent_orange_on_primary</item>
        <item name="colorPrimaryContainer">@color/accent_orange_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/accent_orange_on_primary_container</item>
        <item name="colorSecondary">@color/accent_orange_secondary</item>
        <item name="colorOnSecondary">@color/accent_orange_on_secondary</item>
        <item name="colorSecondaryContainer">@color/accent_orange_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/accent_orange_on_secondary_container</item>
        <item name="colorAccent">@color/accent_orange_primary</item>
        <item name="android:colorAccent">@color/accent_orange_primary</item>
        <item name="colorControlActivated">@color/accent_orange_primary</item>
        <item name="colorControlHighlight">@color/accent_orange_ripple</item>
        <item name="android:colorControlHighlight">@color/accent_orange_ripple</item>
        <item name="colorPrimaryInverse">@color/accent_orange_inverse</item>
    </style>

    <style name="ThemeOverlay.App.Accent.Purple" parent="">
        <item name="colorPrimary">@color/accent_purple_primary</item>
        <item name="colorOnPrimary">@color/accent_purple_on_primary</item>
        <item name="colorPrimaryContainer">@color/accent_purple_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/accent_purple_on_primary_container</item>
        <item name="colorSecondary">@color/accent_purple_secondary</item>
        <item name="colorOnSecondary">@color/accent_purple_on_secondary</item>
        <item name="colorSecondaryContainer">@color/accent_purple_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/accent_purple_on_secondary_container</item>
        <item name="colorAccent">@color/accent_purple_primary</item>
        <item name="android:colorAccent">@color/accent_purple_primary</item>
        <item name="colorControlActivated">@color/accent_purple_primary</item>
        <item name="colorControlHighlight">@color/accent_purple_ripple</item>
        <item name="android:colorControlHighlight">@color/accent_purple_ripple</item>
        <item name="colorPrimaryInverse">@color/accent_purple_inverse</item>
    </style>
</resources>
