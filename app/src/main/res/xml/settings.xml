<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:singleLineTitle="false"
        android:title="@string/nav_settings_cat"
        android:key="navCat">
        <Preference
            android:key="navEditor"
            android:persistent="false"
            android:title="@string/nav_editor_title"
            android:summary="@string/nav_editor_summary" />
        <Preference
            android:key="media_access"
            android:persistent="false"
            android:title="@string/media_access_title"
            android:summary="@string/media_access_summary" />
    </PreferenceCategory>

    <PreferenceCategory
        android:singleLineTitle="false"
        android:title="@string/obd_connection_title">
        <Preference
            android:key="open_obd_settings"
            android:title="@string/action_obd"
            android:summary="@string/section_obd_summary" />
    </PreferenceCategory>

    <PreferenceCategory
        android:singleLineTitle="false"
        android:title="@string/obd_exp_journal">
        <Preference
            android:key="export_regen_log"
            android:title="@string/export_regen_log" />
        <Preference
            android:key="import_regen_log"
            android:title="@string/import_regen_log" />
    </PreferenceCategory>

    <PreferenceCategory
        android:singleLineTitle="false"
        android:title="@string/obd_exp_title">
        <Preference
            android:key="open_experimental"
            android:title="@string/action_experimental"
            android:summary="@string/section_experimental_summary" />
    </PreferenceCategory>

    <PreferenceCategory
        android:singleLineTitle="false"
        android:title="@string/section_about">
        <Preference
            android:key="credits"
            android:title="@string/activity_credits_title" />
        <Preference
            android:key="report_error"
            android:title="@string/report_error" />
        <Preference
            android:key="force_update"
            android:title="@string/force_update" />
        <Preference
            android:key="exit_app"
            android:title="@string/action_exit" />
    </PreferenceCategory>

</PreferenceScreen>
