<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:singleLineTitle="false"
        android:title="@string/profile_settings_cat">
        <Preference
            android:key="profile_manager"
            android:persistent="false"
            android:title="@string/profile_active"
            android:summary="" />
    </PreferenceCategory>

    <PreferenceCategory
        android:singleLineTitle="false"
        android:title="@string/app_appearance_cat">
        <ListPreference
            android:key="app_theme_mode"
            android:title="@string/app_theme_mode_title"
            android:summary="%s"
            android:entries="@array/app_theme_mode_entries"
            android:entryValues="@array/app_theme_mode_values"
            android:defaultValue="system" />
        <com.aadash.prefs.AccentPreference
            android:key="app_accent_picker"
            android:persistent="false"
            android:title="Акцентный цвет"
            app:iconSpaceReserved="true" />
    </PreferenceCategory>

    <PreferenceCategory
        android:singleLineTitle="false"
        android:title="@string/nav_settings_cat"
        android:key="navCat">
        <Preference
            android:key="navEditor"
            android:persistent="false"
            android:title="@string/nav_editor_title"
            android:summary="@string/nav_editor_summary" />
        <Preference
            android:key="media_access"
            android:persistent="false"
            android:title="@string/media_access_title"
            android:summary="@string/media_access_summary" />
    </PreferenceCategory>

    <PreferenceCategory
        android:singleLineTitle="false"
        android:title="@string/obd_connection_title">
        <Preference
            android:key="open_obd_settings"
            android:title="@string/action_obd"
            android:summary="@string/section_obd_summary" />
    </PreferenceCategory>

    <PreferenceCategory
        android:singleLineTitle="false"
        android:title="@string/obd_exp_journal">
        <Preference
            android:key="regen_stats"
            android:persistent="false"
            android:selectable="false"
            android:title="@string/regen_stats_title" />
        <Preference
            android:key="export_regen_log"
            android:title="@string/export_regen_log" />
        <Preference
            android:key="import_regen_log"
            android:title="@string/import_regen_log" />
    </PreferenceCategory>

    <PreferenceCategory
        android:singleLineTitle="false"
        android:title="@string/backup_category">
        <Preference
            android:key="backup_restore"
            android:title="@string/backup_title"
            android:summary="@string/backup_summary" />
    </PreferenceCategory>

    <PreferenceCategory
        android:singleLineTitle="false"
        android:title="@string/obd_exp_title">
        <Preference
            android:key="open_experimental"
            android:title="@string/action_experimental"
            android:summary="@string/section_experimental_summary" />
    </PreferenceCategory>

    <PreferenceCategory
        android:singleLineTitle="false"
        android:title="@string/section_about">
        <Preference
            android:key="credits"
            android:title="@string/activity_credits_title" />
        <Preference
            android:key="report_error"
            android:title="@string/report_error" />
        <Preference
            android:key="force_update"
            android:title="@string/force_update" />
        <Preference
            android:key="install_play_source"
            android:title="@string/install_apk"
            android:summary="@string/install_apk_summary" />
        <Preference
            android:key="exit_app"
            android:title="@string/action_exit" />
    </PreferenceCategory>

</PreferenceScreen>